DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cnpm_524
DB_USER=cnpm_524_app
DB_PASSWORD=CHANGE_ME

# CLI setup only. XAMPP default local root password is empty.
DB_SETUP_USER=root
DB_SETUP_PASSWORD=

# Sao lưu (npm run db:backup). Đặt đường dẫn công cụ nếu không dùng XAMPP mặc định.
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# MYSQLDUMP_PATH=/Applications/XAMPP/xamppfiles/bin/mysqldump
# MYSQL_CLIENT_PATH=/Applications/XAMPP/xamppfiles/bin/mysql

# Must match your browser origin. Use HTTPS and COOKIE_SECURE=true when deployed.
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Web Push: generate once with `npx web-push generate-vapid-keys --json`.
# Keep the private key on the server. Use the same keys for the app and worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Trợ lý AI: DeepSeek trả lời, Tavily tìm thông tin trên web (không bắt buộc)
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
