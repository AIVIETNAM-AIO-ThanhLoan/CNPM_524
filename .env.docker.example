# Copy to .env.docker; use two different, randomly generated passwords.
DB_NAME=cnpm_524_docker
DB_USER=cnpm_524_app
DB_PASSWORD=
DB_SETUP_PASSWORD=

APP_PORT=3000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Optional; use the same VAPID pair for app and worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
